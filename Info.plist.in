<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Terminal.app's Info.plist.

  Copyright © 2026 Kyle J. Cardoza.
  SPDX-FileCopyrightText: 2026 Kyle J. Cardoza
  SPDX-License-Identifier: GPL-3.0-or-later

  THE IDENTIFIER IS THE PROJECT'S CONVENTION (`README.md`, Conventions): `io.github.agoradesktop.NAME`, reverse-DNS
  and lower case, with the product's spelling in CFBundleName. The bundle layout the executable sits in is
  `Contents/<platform>/<arch>/Terminal`, which is what libagora-core's resolver reads.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.agoradesktop.terminal</string>
	<key>CFBundleName</key>
	<string>Terminal</string>
	<key>CFBundleExecutable</key>
	<string>Terminal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@PROJECT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@PROJECT_VERSION@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>10.6</string>
</dict>
</plist>
